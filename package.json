{
  "name": "sslping-marketing-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && npm run build:client && npm run build:ssr && npm run prerender",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir .ssr",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "check": "tsc -b --pretty false && npm run logos:check",
    "logos:sync": "node scripts/sync-service-logos.mjs",
    "logos:refresh": "node scripts/sync-service-logos.mjs --refresh-official",
    "logos:check": "node scripts/sync-service-logos.mjs --check",
    "test": "node --test scripts/production.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-vitals": "6.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "simple-icons": "16.30.0",
    "typescript": "5.7.3",
    "vite": "6.4.3"
  }
}
